# MongoDB Connection String from Railway
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb://mongo:PASSWORD@monorail.proxy.rlwy.net:PORT/railway

# Port for the Express server (Railway will set this automatically)
PORT=3000

# Admin auth (set these in Railway Variables)
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string

# Example MongoDB URI format:
# mongodb://username:password@host:port/database
