# MongoDB Connection String from Railway
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb://mongo:PASSWORD@monorail.proxy.rlwy.net:PORT/railway

# Port for the Express server (Railway will set this automatically)
PORT=3000

# Example MongoDB URI format:
# mongodb://username:password@host:port/database


# Public app URL used in invitation emails
APP_PUBLIC_URL=https://your-project-tracker-domain.com

# SMTP settings used when inviting someone who does not have an account yet
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Project Tracker <no-reply@your-domain.com>"
